# Copy to .env and fill in.

# --- Free setup (recommended): Groq does speech recognition AND translation ---
GROQ_API_KEY=gsk_...
# Optional: translation model on Groq (default openai/gpt-oss-120b; qwen/qwen3.8-27b is also good at Chinese)
# TRANSLATE_MODEL=openai/gpt-oss-120b

# --- Paid alternative: Claude for translation (used automatically when this is set) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Paid alternative: OpenAI Whisper instead of Groq (leave GROQ_API_KEY empty) ---
# OPENAI_API_KEY=sk-...
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Keep audio on your own machine: ASR_PROVIDER=local and `pip install faster-whisper`
# ASR_PROVIDER=local

# Access code the app must send (strongly recommended when the server is online)
API_TOKEN=

MAX_UPLOAD_MB=25
