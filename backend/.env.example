# Copy to .env and fill in.

# Translation (required)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Speech recognition: "openai" (cloud) or "local" (faster-whisper, needs `pip install faster-whisper`)
ASR_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
# LOCAL_WHISPER_MODEL=large-v3

# Optional: require the app to send this token (set the same value in the app's Settings)
API_TOKEN=

MAX_UPLOAD_MB=25
